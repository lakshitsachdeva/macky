## Keep this file safe to commit. Never put real credentials here.
## The SSD-first local launcher overrides cloud integrations with empty values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

## For the SSD-first launcher, keep a real Gemini key only in the ignored
## runtime file: data/backend.env. Never commit the key or paste it into chat.

## Local runtime defaults. `start.sh` sets these explicitly for Custody mode.
RECURDO_LOCAL_MODE=0
RECURDO_AUTO_INDEX_ON_START=1
WATCHED_DIRS=
DB_PATH=./data/memory.db
TEXT_FAISS_PATH=./data/text_faiss.index
VECTORS_DB_PATH=./data/vectors.db
GRAPH_DB_PATH=./data/graph.db
COGNITIVE_DB_PATH=./data/cognitive_layer.db
AUTH_CACHE_PATH=./data/auth_cache.json

# VISUAL_FAISS_PATH was removed in v0.2 — text and visual embeddings
# now share the single unified FAISS index at TEXT_FAISS_PATH / FAISS_PATH.

## Admin-only localhost config endpoint (disabled by default).
# RECURDO_ENABLE_ADMIN_CONFIG=0
# RECURDO_ADMIN_CONFIG_TOKEN=
